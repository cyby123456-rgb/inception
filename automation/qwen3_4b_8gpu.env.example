# Copy this file and edit paths for the eight-GPU host. This is a trusted Bash file.
PYTHON=/path/to/inception/bin/python
MODEL=/path/to/Qwen3-4B
TRAIN_DATA=/path/to/MetaMathQA-valid.json
TEST_DATA=/path/to/GSM8K/test_official.jsonl
WORK_ROOT=/path/to/persistent/qwen3_4b_eight_experiments
GPUS=0,1,2,3,4,5,6,7
LOCAL_EXPERIMENT=no_joint/seed_42

# Option A: automatically pull the immutable checkpoint once the local run finishes.
# Configure SSH key access and known_hosts beforehand. No password prompt is used.
DEPENDENCY_SOURCE=user@local-training-host:/mnt/llmshared-ssd-hd/wangruitao/inception-qwen3-4b/runs/qwen3_4b_matrix_20260918_v2_audited/dependency_exports

# Option B: shared storage or manual copy. Comment DEPENDENCY_SOURCE above and set:
# DEPENDENCY_DIR=/shared/dependency_exports
# The expected bundle is DEPENDENCY_DIR/no_joint_seed_42/READY.json + checkpoint/.
